generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id            String            @id @default(cuid())
  title         String
  titleTr       String?
  titleEn       String?
  slug          String            @unique
  description   String?
  descriptionTr String?
  descriptionEn String?
  location      String?
  year          Int?
  category      String?
  pdfUrl        String?
  featured      Boolean           @default(false)
  published     Boolean           @default(false)
  sortOrder     Int               @default(0)
  images        ProjectImage[]
  categories    ProjectCategory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  originalUrl  String?
  webUrl       String?
  thumbnailUrl String?
  fileSize     Int?
  width        Int?
  height       Int?
  mimeType     String?
  alt          String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  nameTr    String?
  nameEn    String?
  slug      String            @unique
  sortOrder Int               @default(0)
  projects  ProjectCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model HomepageHero {
  id                String   @id
  title             String?
  subtitle          String?
  ctaLabel          String?
  ctaUrl            String?
  mediaType         String   @default("image")
  imageUrl          String?
  imageOriginalUrl  String?
  imageWebUrl       String?
  imageThumbnailUrl String?
  videoUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AboutPage {
  id                String   @id
  eyebrowTr         String?
  eyebrowEn         String?
  titleTr           String?
  titleEn           String?
  descriptionTr     String?
  descriptionEn     String?
  imageUrl          String?
  imageOriginalUrl  String?
  imageWebUrl       String?
  imageThumbnailUrl String?
  imageFileSize     Int?
  imageWidth        Int?
  imageHeight       Int?
  imageMimeType     String?
  approachLabelTr   String?
  approachLabelEn   String?
  approachTitleTr   String?
  approachTitleEn   String?
  materialTitleTr   String?
  materialTitleEn   String?
  materialTextTr    String?
  materialTextEn    String?
  proportionTitleTr String?
  proportionTitleEn String?
  proportionTextTr  String?
  proportionTextEn  String?
  narrativeTitleTr  String?
  narrativeTitleEn  String?
  narrativeTextTr   String?
  narrativeTextEn   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactPage {
  id              String   @id
  businessName    String?
  city            String?
  address         String?
  mapsUrl         String?
  phone           String?
  email           String?
  instagramUrl    String?
  instagramHandle String?
  titleTr         String?
  titleEn         String?
  introTr         String?
  introEn         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FooterSettings {
  id              String   @id
  brandTitleTr    String?
  brandTitleEn    String?
  descriptionTr   String?
  descriptionEn   String?
  businessName    String?
  city            String?
  address         String?
  mapsUrl         String?
  phone           String?
  email           String?
  instagramUrl    String?
  instagramHandle String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Reference {
  id               String   @id @default(cuid())
  companyName      String
  websiteUrl       String?
  logoUrl          String?
  logoOriginalUrl  String?
  logoWebUrl       String?
  logoThumbnailUrl String?
  logoFileSize     Int?
  logoWidth        Int?
  logoHeight       Int?
  logoMimeType     String?
  sortOrder        Int      @default(0)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid())
  questionEn String
  answerEn   String
  questionTr String
  answerTr   String
  sortOrder  Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
