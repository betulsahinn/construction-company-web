{
  "name": "turkuvaz-insaat-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma-cli.mjs generate --local && next dev --turbopack --port 3000",
    "dev:sqlite": "node scripts/prisma-cli.mjs generate --local && next dev --turbopack --port 3000",
    "dev:pg": "node scripts/prisma-cli.mjs generate --postgres && next dev --turbopack --port 3000",
    "build": "node scripts/prisma-cli.mjs generate && next build",
    "build:pg": "node scripts/prisma-cli.mjs generate --postgres && next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "prisma:generate:local": "node scripts/prisma-cli.mjs generate --local",
    "prisma:generate:sqlite": "node scripts/prisma-cli.mjs generate --local",
    "prisma:generate:postgres": "node scripts/prisma-cli.mjs generate --postgres",
    "prisma:migrate:dev": "node scripts/prisma-cli.mjs migrate dev --local",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "node scripts/prisma-cli.mjs db push --local",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "migrate:data:pg:dry-run": "node scripts/generate-postgres-migration-client.mjs && tsx scripts/migrate-sqlite-to-postgres.ts --dry-run",
    "migrate:data:pg": "node scripts/generate-postgres-migration-client.mjs && tsx scripts/migrate-sqlite-to-postgres.ts --execute",
    "migrate:uploads-to-r2": "tsx scripts/migrate-uploads-to-r2.ts",
    "migrate:r2-public-url:dry-run": "node scripts/prisma-cli.mjs generate --postgres && tsx scripts/migrate-r2-public-url.ts --dry-run",
    "migrate:r2-public-url": "node scripts/prisma-cli.mjs generate --postgres && tsx scripts/migrate-r2-public-url.ts --execute",
    "postinstall": "node scripts/prisma-cli.mjs generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.4.7",
    "jose": "^6.0.8",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-masonry-css": "^1.0.16",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
