# Local development (resolved to prisma/dev.db).
# In Vercel, replace this with the PostgreSQL URL supplied by Neon, Supabase,
# Vercel Postgres, or another PostgreSQL provider.
DATABASE_URL="file:./dev.db"

# PostgreSQL/Neon mode only:
# DATABASE_URL="postgresql://<pooled-connection-url>"
# DIRECT_URL="postgresql://<direct-connection-url>"
DIRECT_URL=""

# One-time SQLite -> PostgreSQL data copy target. Keep DATABASE_URL on SQLite
# while running locally; migration scripts read this variable separately.
POSTGRES_DATABASE_URL=""

# Auth
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Contact form email delivery
RESEND_API_KEY=""
CONTACT_TO_EMAIL="info@icmimarmehmeteser.com"
CONTACT_FROM_EMAIL=""

# Admin seed credentials (change before the first production seed)
ADMIN_EMAIL="admin@studio.com"
ADMIN_PASSWORD="admin123"

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.example.com"
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL="https://cdn.example.com"

# One-time database-only R2 public URL migration
OLD_R2_PUBLIC_URL="https://pub-4ee483fa5b544b4e86ba1ca3e49e47ec.r2.dev"
NEW_R2_PUBLIC_URL="https://cdn.icmimarmehmeteser.com"
